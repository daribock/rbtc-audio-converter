    "publish": "electron-forge publish",
    "lint": "eslint .",
    "test": "node --test tests/file-utils.test.js tests/async-utils.test.js tests/audio-utils.test.js tests/validation.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/file-utils.test.js tests/async-utils.test.js tests/audio-utils.test.js tests/validation.test.js"
  },
  "keywords": [],
